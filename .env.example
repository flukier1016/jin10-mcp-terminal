# ══════════════════════════════════════════════════════════════
#  金十实时终端 · 环境变量
#  本地开发：复制为 .env；演示模式无需真实 token
#  Railway / Docker：在平台变量或本机 .env 中配置，不要提交真实密钥
# ══════════════════════════════════════════════════════════════

# ── 运行模式 ────────────────────────────────────────────────────
# true = 完全使用内置演示数据，不访问外网、不消耗额度
DEMO_MODE=false

# ── 数据源 1：金十数据 MCP（实盘模式必需） ──────────────────────
JIN10_MCP_URL=https://mcp.jin10.com/mcp
JIN10_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 数据源 2：智堡 Wisburg MCP（可选，留空则关闭研究模块） ──────
# 官方也支持 https://mcp.wisburg.com/mcp?api_key=<key>，
# 本项目用 Authorization: Bearer 头，避免密钥出现在 URL / 日志里
WISBURG_MCP_URL=https://mcp.wisburg.com/mcp
WISBURG_TOKEN=
# 智堡未公布账户级每日上限，这里是本地保护值；线上 429 会触发整组熔断
WISBURG_DAILY_LIMIT=1000

# ── 智堡研报 Matrix ─────────────────────────────────────────────
# SQLite 默认写入 STATE_DIR/wisburg-matrix.sqlite；容器部署必须挂持久卷
MATRIX_DB_PATH=
# false 时公网 API 只返回元数据、标签与可追溯结论，不返回缓存全文
MATRIX_PUBLIC_CONTENT=false
# 读取完整正文时使用 Authorization: Bearer <MATRIX_ADMIN_TOKEN>
MATRIX_ADMIN_TOKEN=
# Railway 等常驻环境可启用启动后后台续跑；本地建议用 npm run matrix:sync
WISBURG_MATRIX_AUTO_SYNC=false
# 单页拉满 100；列表与详情均受 WISBURG_DAILY_LIMIT、共享远端限流和安全垫约束
WISBURG_SYNC_PAGE_SIZE=100
WISBURG_SYNC_MAX_PAGES_PER_SOURCE=900
# 实测两个详情工具共享约 500 次硬限流；总量留 20 次安全垫并在报告/文章间均分
WISBURG_SYNC_MAX_DETAIL_CALLS=480
WISBURG_SYNC_MAX_REPORT_DETAILS=240
WISBURG_SYNC_MAX_ARTICLE_DETAILS=240
WISBURG_SYNC_CONCURRENCY=4

# MCP 协议版本
MCP_PROTOCOL_VERSION=2025-11-25

# ── 服务 ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# 额度状态目录；重启后继续当天计数。容器部署应挂载持久卷
STATE_DIR=.data
# 生产同源可留空；分离前后端时可填一个或多个逗号分隔的前端 Origin
CORS_ORIGIN=

# ── Vite 前端（仅开发/构建时读取，绝不能放 token）──────────────
# 开发代理要连接的后端
VITE_API_TARGET=http://localhost:8080
# 开发服务器监听地址；需要用手机访问本机时改为 0.0.0.0
VITE_DEV_HOST=127.0.0.1
# 前后端分离部署时填 API Origin，如 https://api.example.com；同源留空
VITE_API_BASE_URL=

# ── 额度与调度 ──────────────────────────────────────────────────
# 金十官方：每用户每工具每天 1500 次，按北京时间自然日重置
DAILY_TOOL_LIMIT=1500
# 安全垫，避免踩到硬上限
QUOTA_RESERVE_RATIO=0.1
#
# 关键参数：额度要铺满多少小时。
#   24 → 86400s ÷ (1500 × 0.9) = 64 秒/次，把日额度拉满且全天不断供
#   12 → 32 秒/次，但只够半天
SUSTAIN_HOURS=24
#
# 24/7 常驻：没有浏览器连着也继续刷新，保证随时打开就是新数据
POLL_WHEN_IDLE=true
# 始终覆盖总览宇宙（约 33 个品种），而不是只覆盖当前订阅
ALWAYS_ON_UNIVERSE=true
# 前台聚焦品种的额外刷新权重
FOCUS_BOOST=6

# ── 默认自选 ────────────────────────────────────────────────────
DEFAULT_WATCHLIST=XAUUSD,XAGUSD,USOIL,UKOIL,USDCNH,USDJPY,EURUSD,COPPER
